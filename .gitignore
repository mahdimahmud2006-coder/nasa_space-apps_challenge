# ==============================================================================
# TerraPulse .gitignore
# NASA Space Apps Challenge - Dancing with the SARs
# ==============================================================================

# ------------------------------------------------------------------------------
# Raw Earth Observation products and heavy scientific data
# Raw NASA-ISRO NISAR L2 GCOV HDF5 files (>7 GB each) are strictly excluded.
# ------------------------------------------------------------------------------
*.h5
*.H5
*.hdf5
*.HDF5
*.he5
*.nc
*.nc4
database for imp2/

# ------------------------------------------------------------------------------
# Full-resolution reproducible analytical rasters (GeoTIFF)
# Heavy analytical rasters (>10-20 MB each) are reproducible via `make process`.
# Compact public demo assets (WebP, GeoJSON, lightweight JSON) remain tracked.
# ------------------------------------------------------------------------------
*.tif
*.tiff
*.TIF
*.TIFF
*.geotiff

# ------------------------------------------------------------------------------
# Archives and compressed bundles
# ------------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.xz
*.7z
*.rar

# Explicit exception: Whitelist compact official validation archive (312 KB)
!data/context/unosat_20260826_flood_extent.zip

# ------------------------------------------------------------------------------
# Credentials, secrets, and environment configurations
# Never commit NASA Earthdata credentials, tokens, or personal .env files
# ------------------------------------------------------------------------------
*.netrc
.netrc
.env
.env.*
!.env.example
*.pem
*.key

# ------------------------------------------------------------------------------
# Python runtime, bytecode, and packaging caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# Virtual environments and package manager caches
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.uv-cache/
.uv/
node_modules/
.npm/

# ------------------------------------------------------------------------------
# Testing, coverage, and type-checking caches
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.ruff_cache/
.mypy_cache/

# ------------------------------------------------------------------------------
# Editor, IDE, and operating system artifacts
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# ------------------------------------------------------------------------------
# Logs, runtime scratch, and temporary files
# ------------------------------------------------------------------------------
*.log
*.tmp
.cache/
scratch/
tmp/
temp/

# Large reproducible scenario component arrays; retain the compact source manifests.
/data/derived/**/components.npz

# Final application runtime assets are required for local cell probes and scenarios.
# Raw HDF5/source caches remain excluded; the compact component cube is ~17 MB.
!web/public/cases/**/*.tif
!/data/derived/nepal_case_01/flood/components.npz
